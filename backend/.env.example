# Kunci Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=PLACEHOLDER_ganti_dengan_kunci_gemini_anda

# Kunci OpenRouter untuk mesin premium "Athena Mode" — https://openrouter.ai/keys
# Opsional; kosongkan kalau belum dipakai.
OPENROUTER_API_KEY=

# Opsional: ganti model Athena tanpa ubah kode (https://openrouter.ai/models?q=free)
# ATHENA_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Kredensial service account Firebase (Project settings -> Service accounts -> Generate new private key)
# Isi salah satu: path ke file JSON, atau isi JSON-nya langsung (berguna untuk deploy).
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", ...}

# Asal frontend yang diizinkan, pisahkan dengan koma
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
